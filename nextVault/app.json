{
  "expo": {
    "name": "Tracker",
    "slug": "nextVault",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/plane-mode.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/travelling.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.next.nextVault"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/plane-mode.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.next.nextVault"
    },
    "web": {
      "favicon": "./assets/travelling.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-notifications",
      "expo-sharing"
    ]
  }
}
